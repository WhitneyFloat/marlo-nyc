function PhoneFrame({ children, label }) {
return (
<div style={{ display: “flex”, flexDirection: “column”, alignItems: “center”, gap: 12 }}>
<div style={{ fontSize: 11, color: theme.stone, fontFamily: “sans-serif”, letterSpacing: “0.1em”, textTransform: “uppercase” }}>{label}</div>
<div style={{ width: 340, height: 680, background: theme.charcoal, borderRadius: 44, padding: 12, boxShadow: “0 32px 80px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,255,255,0.1)” }}>
{/* Notch */}
<div style={{ width: 100, height: 28, background: theme.charcoal, borderRadius: 100, margin: “0 auto 8px”, position: “relative”, zIndex: 10 }} />
<div style={{ height: 580, borderRadius: 34, overflow: “hidden” }}>
{children}
</div>
</div>
</div>
);
}

function AnnotationCard({ icon, title, body }) {
return (
<div style={{ background: “rgba(255,255,255,0.04)”, border: “1px solid rgba(255,255,255,0.08)”, borderRadius: 16, padding: 20 }}>
<div style={{ fontSize: 20, marginBottom: 8 }}>{icon}</div>
<div style={{ fontSize: 14, color: theme.cream, marginBottom: 6 }}>{title}</div>
<div style={{ fontSize: 13, color: theme.stone, fontFamily: “sans-serif”, lineHeight: 1.6 }}>{body}</div>
</div>
);
}
