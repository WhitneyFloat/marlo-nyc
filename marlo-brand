// ─── COMPONENTS ──────────────────────────────────────────────────────────────

function MarloWordmark({ size = 28, light = false }) {
return (
<div style={{ display: “flex”, alignItems: “baseline”, gap: size * 0.15 }}>
<span style={{ fontSize: size, fontFamily: “‘Palatino Linotype’, ‘Book Antiqua’, Palatino, serif”, color: light ? “#F8F4EE” : M.ink, letterSpacing: “-0.02em”, fontWeight: 400, lineHeight: 1 }}>marlo</span>
<span style={{ width: size * 0.18, height: size * 0.18, borderRadius: “50%”, background: M.terracotta, display: “inline-block”, marginBottom: size * 0.05 }} />
</div>
);
}

function Btn({ label, light = false }) {
return (
<div style={{ background: light ? “rgba(255,255,255,0.2)” : M.ink, borderRadius: 100, padding: “14px 24px”, textAlign: “center”, color: “#fff”, fontSize: 14, fontFamily: M.fontBody, cursor: “pointer” }}>{label}</div>
);
}

function PhoneFrame({ children, label }) {
return (
<div style={{ display: “flex”, flexDirection: “column”, alignItems: “center”, gap: 12 }}>
<div style={{ fontSize: 10, color: M.stone, fontFamily: M.fontBody, letterSpacing: “0.15em”, textTransform: “uppercase” }}>{label}</div>
<div style={{ width: 340, height: 680, background: M.ink, borderRadius: 44, padding: 12, boxShadow: “0 40px 100px rgba(0,0,0,0.7), inset 0 0 0 1px rgba(255,255,255,0.08)” }}>
<div style={{ width: 90, height: 26, background: M.ink, borderRadius: 100, margin: “0 auto 8px”, position: “relative”, zIndex: 10 }} />
<div style={{ height: 582, borderRadius: 34, overflow: “hidden” }}>{children}</div>
</div>
</div>
);
}

function Section({ label, children }) {
return (
<div style={{ marginBottom: 48 }}>
<div style={{ fontSize: 10, color: M.stone, letterSpacing: “0.25em”, fontFamily: M.fontBody, marginBottom: 16, textTransform: “uppercase” }}>{label}</div>
{children}
</div>
);
}

function ScreenLayout({ label, children }) {
return (
<div style={{ display: “flex”, gap: 40, flexWrap: “wrap”, justifyContent: “center”, alignItems: “flex-start” }}>
{children}
</div>
);
}

function AnnotationPanel({ items }) {
return (
<div style={{ display: “flex”, flexDirection: “column”, gap: 16, maxWidth: 300, justifyContent: “center” }}>
{items.map(a => (
<div key={a.title} style={{ background: “rgba(255,255,255,0.03)”, border: “1px solid rgba(255,255,255,0.07)”, borderRadius: 16, padding: 22 }}>
<div style={{ fontSize: 18, marginBottom: 8, color: M.terracotta, fontFamily: M.fontDisplay }}>{a.icon}</div>
<div style={{ fontSize: 14, color: M.cream, fontFamily: M.fontDisplay, marginBottom: 8 }}>{a.title}</div>
<div style={{ fontSize: 13, color: M.stone, fontFamily: M.fontBody, lineHeight: 1.65 }}>{a.body}</div>
</div>
))}
</div>
);
}
